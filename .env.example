# Copy to .env and fill in local dev values. .env is gitignored — never commit
# real secrets. These are LOCAL DEV placeholders only; production secrets come
# from Vault (ADR-008 / security.secrets), never from a committed file.

# --- Postgres ---
POSTGRES_USER=hip
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=hip

# --- Keycloak (identity) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only

# --- Vault (secrets/keys) ---
VAULT_DEV_ROOT_TOKEN=change-me-local-only

# --- MinIO (object store) ---
MINIO_ROOT_USER=hip
MINIO_ROOT_PASSWORD=change-me-local-only

# --- App ---
HIP_ENV=local

# --- Rate limiting (per-client throttling; off unless set) ---
# HIP_RATE_LIMIT=600            # requests per window per client (0/unset = disabled)
# HIP_RATE_WINDOW_SECONDS=60

# --- Database (async SQLAlchemy URL; cloud-agnostic) ---
# Local dev default is used if unset. In prod point this at the client's Postgres.
# HIP_DATABASE_URL=postgresql+asyncpg://hip:hip@localhost:5432/hip

# --- Encryption at rest (KeyManager; PHI is encrypted before storage) ---
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, the gateway/ingestion fail closed (never store PHI unencrypted).
# In production this comes from Vault (below), not a committed file.
# HIP_ENCRYPTION_KEY=
# Blind-index HMAC key for encrypted-identifier search (any high-entropy secret).
# Without it, FHIR search is unavailable (503). From Vault in production.
# HIP_BLIND_INDEX_KEY=

# --- Vault (production key source, ADR-003 — takes priority over the two keys
# above when set; a Vault that's configured but unreachable is a hard startup
# error, not a silent fall-back). KV-v2 secrets, e.g.:
#   vault kv put secret/hip/encryption-key key=<fernet-key>
#   vault kv put secret/hip/blind-index-key key=<hmac-key>
# HIP_VAULT_ADDR=http://localhost:8200
# HIP_VAULT_TOKEN=
# HIP_VAULT_ENCRYPTION_KEY_PATH=secret/data/hip/encryption-key
# HIP_VAULT_BLIND_INDEX_KEY_PATH=secret/data/hip/blind-index-key

# --- Auth / JWT (gateway.auth validates Keycloak-issued tokens) ---
# Provide ONE of the following, in priority order. Without any, the gateway
# fails closed (401).
# HIP_JWT_JWKS_URL=    # e.g. http://localhost:8080/realms/hip/protocol/openid-connect/certs
#                      # — the Keycloak path: live JWKS fetch, keyed by token `kid`
# HIP_JWT_PUBLIC_KEY=  # single static realm RS256 public key (PEM), no live fetch
# HIP_JWT_SECRET=      # HS256 shared secret — simpler/self-contained setups & tests
# HIP_JWT_ISSUER=      # optional: expected token issuer
# HIP_JWT_AUDIENCE=    # optional: expected audience (aud verified if set)
